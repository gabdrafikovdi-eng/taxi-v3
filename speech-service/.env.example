# ===== STT (GigaAM) =====
# Канонический ключ модели из реестра:
#   gigaam_v2_ctc, gigaam_v2_rnnt,
#   gigaam_v3_ctc, gigaam_v3_rnnt, gigaam_v3_e2e_ctc, gigaam_v3_e2e_rnnt,
#   gigaam_multilingual_ctc, gigaam_multilingual_large_ctc
# Принимаются также старые имена (gigaam-v2-ctc, rnnt, v3_rnnt и т.п.).
STT_MODEL=gigaam_v3_rnnt
# Язык распознавания (метаданные; gigaam не принимает language в transcribe).
STT_LANGUAGE=ru
# Устройство: "cuda:0" для GPU-сервера, "cpu" для Mac/M1/M2.
STT_DEVICE=cuda:0
# Если CUDA недоступна — загружать GigaAM на CPU.
STT_FALLBACK_TO_CPU=true
# Выгружать production-модель на время benchmark (экономия RAM).
# По умолчанию выключено: на production-сервере с трафиком benchmark не гоняют.
STT_BENCHMARK_RELEASES_PRODUCTION=false

# ===== TTS (edge-tts, облачный Microsoft) =====
TTS_VOICE=ru-RU-DmitryNeural

# ===== Общие =====
MAX_AUDIO_DURATION_SEC=30
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001