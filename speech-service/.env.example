# ===== STT (GigaAM) =====
# Имя модели для gigaam.load_model (gigaam-v3-rnnt -> rnnt).
STT_MODEL=gigaam-v3-rnnt
# Устройство: "cuda:0" для GPU-сервера, "cpu" для Mac/M1/M2.
STT_DEVICE=cuda:0
# Если CUDA недоступна — загружать GigaAM на CPU.
STT_FALLBACK_TO_CPU=true

# ===== TTS (Silero) =====
TTS_SPEAKER=baya
TTS_SAMPLE_RATE=48000

# ===== Общие =====
MAX_AUDIO_DURATION_SEC=30
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001