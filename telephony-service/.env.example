# ===== Asterisk ARI (управление звонками) =====
# URL ARI: из контейнера telephony — имя сервиса asterisk;
# при запуске telephony на хосте (dev) — http://localhost:8088
ASTERISK_ARI_URL=http://asterisk:8088
ASTERISK_ARI_USERNAME=taxi
ASTERISK_ARI_PASSWORD=change-me-strong
ASTERISK_ARI_APP=taxi
# Реконнект WebSocket ARI (экспоненциальный backoff, сек)
ARI_RECONNECT_MIN_SEC=1
ARI_RECONNECT_MAX_SEC=30

# ===== Media pipeline =====
# Формат телефонного аудио: ulaw (G.711 µ-law, GoIP по умолчанию) или alaw (G.711 A-law)
MEDIA_FORMAT=ulaw
# Хост/имя, по которому Asterisk достукивается до RTP-сокетов telephony-service
# (внутри compose-сети — имя сервиса; на одном хосте без docker — IP хоста)
TELEPHONY_EXTERNAL_HOST=taxi-telephony
# Диапазон UDP-портов telephony-service для внешних медиа-каналов
# (ОТЛИЧАЕТСЯ от диапазона RTP самого Asterisk: 10000-10100, см. asterisk/config/rtp.conf)
RTP_SERVICE_PORT_START=18000
RTP_SERVICE_PORT_END=18050

# ===== speech-service (существующий сервис, НЕ изменяется) =====
# В dev: speech-service запущен на Mac-хосте (uvicorn :8001)
SPEECH_SERVICE_URL=http://host.docker.internal:8001
STT_TIMEOUT_SEC=10
TTS_TIMEOUT_SEC=20

# ===== backend (существующий сервис, НЕ изменяется) =====
# mock  — встроенная заглушка для разработки/ручного теста pipeline;
# http  — HTTP-контракт из README (backend пока не имеет такого API — см. BLOCKER в README)
BACKEND_MODE=mock
BACKEND_URL=http://backend:8000
BACKEND_TIMEOUT_SEC=30

# ===== Пороги сегментации фраз (turn-taking) =====
# RMS (linear int16) выше порога считается речью
ENERGY_SPEECH_THRESHOLD=900
# Сколько мс тишины завершает фразу
SILENCE_MS=700
# Минимальная длительность речи, мс (короче — отбрасываем как шум)
MIN_SPEECH_MS=300
# Максимальная длительность одной реплики, мс
MAX_UTTERANCE_MS=15000
# Сколько мс аудио до начала речи включать в реплику
PREROLL_MS=200

# ===== Лимиты звонка =====
MAX_CALL_DURATION_SEC=600
# Проигрывать приветствие при ответе (берётся из backend.greeting())
PLAY_GREETING=true

# ===== Health / логирование =====
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8090
LOG_LEVEL=INFO

# ===== Конфигурация контейнера Asterisk (рендер шаблонов) =====
# digest — GoIP с SIP-логином/паролем (dev: Docker NAT скрывает реальный IP GoIP);
# ip     — identification по IP (production: GoIP в VPN-сети со стабильным адресом)
GOIP_AUTH_MODE=digest
GOIP_HOST=192.168.1.50
GOIP_SIP_PASSWORD=goip4-secret
