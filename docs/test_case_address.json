{
  "test_suite": "AddressService + Suggestions",
  "description": "Integration/regression scenarios for AddressService including address resolution, normalization, fuzzy matching, landmarks and house suggestions.",
  "documentation": {
    "_comment": "ЭТОТ ФАЙЛ ЯВЛЯЕТСЯ ОСНОВНЫМ ИСТОЧНИКОМ ТРЕБОВАНИЙ ДЛЯ ТЕСТОВ. Pytest читает его при КАЖДОМ запуске (tests/scenario_loader.py). Изменения в этом файле автоматически влияют на следующий запуск pytest. Не копируйте сценарии вручную в код тестов.",
    "fields": {
      "id": "Уникальный идентификатор сценария (например, A01, S42). Обязательное поле.",
      "input": "Объект AddressInput: town, district, street, house, landmark. Все поля опциональны (null допустим).",
      "expected_status": "Ожидаемый статус AddressMatchResult: INCOMPLETE | RESOLVED | AMBIGUOUS | NOT_FOUND. Допустимы комбинированные значения (тест проходит при любом из перечисленных статусов): NOT_FOUND_OR_RESOLVED, AMBIGUOUS_OR_RESOLVED_ACCORDING_TO_DB, RESOLVED_OR_NOT_FOUND_ACCORDING_TO_DISTRICT_FILTER, RESOLVED_OR_NOT_FOUND_ACCORDING_TO_LANDMARK_FUZZY_RULES, NOT_FOUND_OR_RESOLVED_ACCORDING_TO_DB.",
      "expected_candidates": "Ожидаемый список кандидатов (обычно [] для NOT_FOUND/INCOMPLETE).",
      "expected_suggestions": "Ожидаемый список suggestions (обычно []).",
      "expected_suggestions_non_empty": "true — suggestions НЕ должны быть пустыми.",
      "expected_resolved_street": "Ожидаемое имя улицы у единственного RESOLVED-кандидата (для fuzzy-проверок).",
      "expected_street": "Ожидаемая улица кандидата (например, для landmark-сценариев).",
      "expected_house": "Ожидаемый номер дома кандидата (например, для landmark-сценариев).",
      "expected_suggestion_contains": "Список номеров домов, которые ДОЛЖНЫ присутствовать среди suggestions.",
      "expected_suggestion_excludes": "Список номеров домов, которых НЕ должно быть среди suggestions.",
      "suggestions_limit": "Максимально допустимое число suggestions (тест проверяет len(suggestions) <= limit).",
      "suggestions_rule": "Человекочитаемое правило отбора suggestions (например, 'suggest houses with base number 14 only'). Тест проверяет, что все suggestions соответствуют правилу (base + структура номера).",
      "assertion": "Человекочитаемое требование. Сопоставляется с предикатом из tests/scenario_assertions.py. Если предикат не найден — тест получает FAIL с сообщением 'unhandled assertion', а не молча пропускается."
    },
    "example": {
      "id": "S_EXAMPLE",
      "input": {
        "street": "Ленина",
        "district": "Центр",
        "house": "14к9"
      },
      "expected_status": "NOT_FOUND",
      "expected_candidates": [],
      "expected_suggestion_contains": [
        "14к1"
      ],
      "expected_suggestion_excludes": [
        "14а",
        "14/1",
        "14"
      ],
      "suggestions_limit": 3,
      "assertion": "suggestions must preserve corpus structure"
    }
  },
